[Unit]
Description=FleetComb Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=fleetcomb-agent
Group=fleetcomb-agent
Environment=FLEETCOMB_AGENT_DATA_DIR=/var/lib/fleetcomb-agent
ExecStart=/opt/fleetcomb-agent/FleetComb.Agent
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fleetcomb-agent

[Install]
WantedBy=multi-user.target
