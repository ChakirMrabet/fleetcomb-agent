@page
@model IndexModel
@{
    ViewData["Title"] = "Status";
}
<section class="hero">
  <p class="eyebrow">Instrument connection</p>
  <h1>FleetComb Agent</h1>
  <p>Local status, assigned software, updates, and optional customer integration.</p>
</section>

<section class="grid">
  <article>
    <h2>Connection</h2>
    <dl>
      <div><dt>Status</dt><dd id="sync-state" data-state="@Model.Synchronization.State">@Model.Synchronization.State</dd></div>
      <div><dt>Asset</dt><dd>@Model.Registration?.AssetId</dd></div>
      <div><dt>FleetComb</dt><dd>@Model.Registration?.ServerUrl</dd></div>
      <div><dt>Last synchronized</dt><dd id="sync-last-success">@(Model.Synchronization.LastSuccessfulAt?.ToLocalTime().ToString("g") ?? "Never")</dd></div>
    </dl>
    <p id="sync-error" class="error">@Model.Synchronization.LastError</p>
  </article>
  <article>
    <h2>Product</h2>
    @if (Model.Desired?.Product is { } product)
    {
      <strong>@product.Name</strong>
      <p>@product.PartNumber</p>
    }
    else
    {
      <p>Waiting for FleetComb configuration.</p>
    }
  </article>
  @if (!string.IsNullOrWhiteSpace(Model.Adapter.Name))
  {
    <article id="local-integration">
      <h2>Local integration</h2>
      <strong id="adapter-state" data-state="@Model.Adapter.State">@Model.Adapter.State</strong>
      <p><span id="adapter-name">@Model.Adapter.Name</span> <span id="adapter-version">@Model.Adapter.Version</span></p>
      <small id="adapter-last-seen">@(Model.Adapter.LastSeenAt?.ToLocalTime().ToString("g") ?? "Never connected")</small>
    </article>
  }
  <article>
    <h2>Current update</h2>
    <strong id="update-state">@Model.Update.State</strong>
    <p id="update-message">@Model.Update.Message</p>
    <progress id="update-progress" max="100" value="@Model.Update.ProgressPercent"></progress>
  </article>
</section>

<script src="/agent-ui/signalr.min.js" defer></script>
<script src="/agent-ui/status.js" defer></script>

<section class="panel">
  <h2>Applications</h2>
  @if (Model.Desired is null)
  {
    <p>Desired software has not synchronized yet.</p>
  }
  else
  {
    @foreach (var platform in Model.Desired.SoftwarePlatforms)
    {
      <h3>@platform.Name <small>@platform.PartNumber</small></h3>
      <table>
        <thead><tr><th>Application</th><th>Installed</th><th>Available</th><th>Action</th></tr></thead>
        <tbody>
        @foreach (var application in platform.Applications)
        {
          var installed = Model.Inventory.FirstOrDefault(x => x.ApplicationId == application.Id);
          var release = application.LatestRelease;
          var updateAvailable = release is not null && !string.Equals(
            installed?.InstalledVersion, release.Version, StringComparison.OrdinalIgnoreCase);
          var applicationDomId = application.Id.ToString("N");
          <tr>
            <td>@application.Name</td>
            <td id="installed-@applicationDomId">@(installed?.InstalledVersion ?? "Not reported")</td>
            <td>@(release?.Version ?? "No matching release")</td>
            <td>
              @if (updateAvailable)
              {
                <form method="post" asp-page-handler="Install" class="update-form"
                      data-update-form data-application-id="@application.Id"
                      data-available-version="@release!.Version">
                  <input type="hidden" name="applicationId" value="@application.Id" />
                  <button type="submit">@(installed is null ? "Install" : "Update")</button>
                </form>
              }
              else if (release is not null)
              {
                <span>Up to date</span>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    }
  }
</section>

<section class="panel" id="authorized-users">
  <h2>Authorized users</h2>
  @if (Model.AuthorizedUsers is null)
  {
    <p>Authorization data has not synchronized yet.</p>
  }
  else if (Model.AuthorizedUsers.Users.Count == 0)
  {
    <p>No users are currently authorized for this instrument.</p>
  }
  else
  {
    <p>
      <small>
        Asset @Model.AuthorizedUsers.AssetSerialNumber ·
        Policy revision @Model.AuthorizedUsers.PolicyRevision
      </small>
    </p>
    <table>
      <thead><tr><th>User</th><th>Username</th><th>Authorized until</th></tr></thead>
      <tbody>
      @foreach (var user in Model.AuthorizedUsers.Users)
      {
        <tr>
          <td>@user.DisplayName</td>
          <td>@user.Username</td>
          <td>@user.NotAfter.ToLocalTime().ToString("g")</td>
        </tr>
      }
      </tbody>
    </table>
  }
</section>
