@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="form-card">
  <p class="eyebrow">Instrument administration</p>
  <h1>Sign in</h1>
  <form method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Password">Local administrator password</label>
    <input asp-for="Password" type="password" autocomplete="current-password" autofocus />
    <button type="submit">Sign in</button>
  </form>
</section>
